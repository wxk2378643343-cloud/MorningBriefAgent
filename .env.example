# ==============================================================================
# MorningBriefAgent - Configuration Template (.env.example)
# Copy this file to .env and fill in your actual credentials.
# ==============================================================================

# Feishu Official App Credentials
FEISHU_APP_ID=cli_your_feishu_app_id_here
FEISHU_APP_SECRET=your_feishu_app_secret_here

# Feishu Target Identifiers
FEISHU_USER_OPEN_ID=ou_your_user_open_id_here
FEISHU_CHAT_ID=oc_your_chat_id_here

# Only these users may trigger local tools through the bot (comma separated)
FEISHU_ALLOWED_OPEN_IDS=ou_your_user_open_id_here

# Local paths (examples; replace with paths on your computer)
VAULT_ROOT=D:\path\to\your\obsidian-vault
EMAIL_INBOX_DIRS=D:\path\to\mail\inbox;D:\path\to\another\mail\inbox
TECH_NEWS_DIR=D:\path\to\technical\digest
STUDY_TRACKER_PATH=
TODAY_TODO_PATH=D:\path\to\knowledge-base\daily-plan.md
TODO_ARCHIVE_DIR=D:\path\to\knowledge-base\plan-archive
AGENT_CONTEXT_FILES=
AGENT_CONTEXT_DIRS=
WECHAT_TOOLS_DIR=D:\path\to\wechat-decrypt
WECHAT_MSG_DB=D:\path\to\decrypted\message\message_0.db
WECHAT_CONTACT_DB=D:\path\to\decrypted\contact\contact.db
WECHAT_GROUP_KEYWORDS=important-group
WECHAT_EXCLUDED_USERNAMES=wxid_example
WECHAT_EXCLUDED_NAME_KEYWORDS=self-notes
LOCAL_PROXY=
MARKET_DATA_URL=https://hq.sinajs.cn
PORTFOLIO_FILE=D:\path\to\MorningBriefAgent\data\portfolio.json

# Optional local Antigravity bridge
AGENTAPI_EXE=C:\path\to\language_server.exe
AGY_BRAIN_DIR=C:\path\to\antigravity\brain
AGY_CONVERSATION_ID=your-conversation-id

# Optional target date used only when present in local context
EXAM_DATE_STR=
